    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #10120f; color: #edeae1; }
      * { box-sizing: border-box; }
      body { min-width: 320px; min-height: 100vh; margin: 0; display: grid; place-items: center; padding: clamp(16px, 4vw, 48px); background: radial-gradient(ellipse at 50% 0, rgba(234,191,78,.14), transparent 52%), #10120f; }
      main { width: min(100%, 1100px); animation: invite-arrive 720ms cubic-bezier(.2,.8,.2,1) both; }
      .poster { display: block; width: 100%; height: auto; border: 1px solid rgba(234,191,78,.35); border-radius: 14px; box-shadow: 0 24px 80px rgba(0,0,0,.46); }
      .message { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 22px; padding: 22px 24px; border: 1px solid rgba(234,191,78,.18); border-radius: 12px; background: rgba(23,26,22,.94); }
      .copy { min-width: 0; }
      .eyebrow { color: #eabf4e; font-size: 10px; font-weight: 800; letter-spacing: .18em; }
      h1 { margin: 7px 0 6px; font-size: clamp(20px, 3vw, 30px); line-height: 1.16; letter-spacing: -.035em; }
      p { margin: 0; color: #b8b8ac; font-size: 14px; line-height: 1.6; }
      .button { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 18px; border-radius: 8px; background: #eabf4e; color: #18160f; font-size: 13px; font-weight: 800; text-decoration: none; transition: background .18s, transform .18s; }
      .button:hover { background: #f6d77b; transform: translateY(-1px); }
      @keyframes invite-arrive { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
      @media (max-width: 680px) { .message { align-items: stretch; flex-direction: column; padding: 18px; } .button { width: 100%; } }
      @media (prefers-reduced-motion: reduce) { main { animation: none; } .button { transition: none; } }
    </style>
