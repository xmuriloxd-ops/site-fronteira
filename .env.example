# ---------------------------------------------------------------
# PCPR RP · Sistema de Registro de Prisões — variáveis de ambiente
# Nenhuma delas é obrigatória para rodar localmente.
# ---------------------------------------------------------------

# Porta HTTP do servidor (o host de deploy costuma definir sozinho).
PORT=3000

# `production` serve o build de `dist/` e não abre a porta de preview.
# NODE_ENV=production

# Pasta onde fica `dados-pcpr-rp.json` (prisões, config do Discord, histórico).
# Em Docker aponte para um volume, ex.: /app/dados.
# PC_DATA_DIR=/app/dados
