# ---------------------------------------------------------------
# Portal de Inscrições PMPR — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste o que for necessário.
# Nenhuma delas é obrigatória para rodar localmente.
# ---------------------------------------------------------------

# Porta HTTP do servidor (o host de deploy costuma definir sozinho).
PORT=3000

# `production` serve o build de `dist/` e não abre a porta de preview.
NODE_ENV=production

# Pasta dos dados do portal (portal-data.json, .portal-secret, .portal-sessao.json).
# Em Docker aponta para o volume /app/dados. Vazio = raiz do projeto.
# PORTAL_DATA_DIR=/app/dados

# Segredo que assina os tokens do comando.
# Se ficar vazio, o servidor cria `.portal-secret` na pasta de dados.
# Defina em produção para manter as sessões válidas entre deploys.
# PORTAL_SECRET=uma-frase-longa-e-aleatoria-com-32-caracteres-ou-mais
