node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Dados locais do sistema (denúncias, evidências, webhook do Discord)
dados-corregedoria-pmpr.json
dados-corregedoria-pmpr.json.tmp
.dados/
image-search/

# Pastas de trabalho locais
.exemplos/
entregas/
.dados-preview/

# Pacotes de download gerados
/downloads/

# Fronteira do Sul: o que o administrador muda pelo painel fica em
# fronteira-sul/dados/. Os textos, as opções (conteudo.json) e as imagens
# enviadas vão para o repositório: é deles que sai o site publicado. O acesso
# do painel (usuário e senha) e o histórico ficam só onde o servidor roda.
fronteira-sul/dados/*
!fronteira-sul/dados/conteudo.json
!fronteira-sul/dados/imagens/
fronteira-sul/dados/imagens/*.tmp
